# ================================
# Registry Service — Port 5001
# ================================

PORT=5001

# MongoDB connection string for the registry database
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# JWT secret used to verify tokens issued by the auth engine
# Must match the JWT_SECRET in auz-engine
JWT_SECRET=your_jwt_secret_here
