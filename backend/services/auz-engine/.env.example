# ================================
# Auth Engine (auz-engine) — Port 3000
# ================================

PORT=3000

# MongoDB connection string for the auth/user-role database
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# JWT secret used to sign and verify tokens (use a long random string in production)
JWT_SECRET=your_jwt_secret_here
